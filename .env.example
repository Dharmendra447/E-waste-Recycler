This file is for the server. Create a .env file in the root directory and add this content.
You can change this to any long, random string for better security.
JWT_SECRET="your-super-secret-key-that-is-long-and-random"

# Server-side Google Gemini configuration. Do not use VITE_ for this key.
GEMINI_API_KEY="your-google-gemini-api-key"
GEMINI_MODEL="gemini-3.5-flash-lite"
ECOAI_RAG_SERVICE_URL="http://127.0.0.1:8000"